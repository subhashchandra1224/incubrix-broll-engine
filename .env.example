# ============================================================================
# B-roll Engine - example environment configuration.
# Copy this file to ".env" and adjust values. NEVER commit real secrets.
# The defaults below let the whole app run with ZERO API keys (mock providers),
# which is how the default/test path must work.
# ============================================================================

# ---- Application ----
APP_NAME=B-roll Engine
APP_VERSION=0.1.0
# dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
# true = structured JSON logs (production); false = human-readable (local dev)
LOG_JSON=true

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# ---- Database ----
# SQLite for the local demo. Docker Compose shares this file via a volume
# between the api and worker services.
DATABASE_URL=sqlite:///./data/broll.db
DB_ECHO=false

# ---- Storage ----
# local | s3  (s3 uses MinIO in docker-compose)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
# S3 / MinIO - only used when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=broll-engine
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ---- Job processing ----
JOB_MAX_CONCURRENCY=1
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_TTL_DAYS=7
# Threshold (seconds): anything expected to take longer than this runs as a
# background job (POST returns 202 with a job_id).
JOB_MIN_DURATION_SECONDS=2.0
# Optional HMAC secret used to sign job-completion callbacks in the
# X-IncuBrix-Signature header. Leave blank to disable signed callbacks.
CALLBACK_HMAC_SECRET=

# ---- Provider selection ----
# Each capability picks an adapter by name. "mock" needs no API keys and is
# the default so tests run with no external services.
STT_PROVIDER=mock
TTS_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
SCENE_PROVIDER=mock
FOOTAGE_PROVIDER=mock
# Comma-separated fallback footage providers tried after the primary (e.g. mock).
FOOTAGE_FALLBACK_PROVIDERS=
SAFETY_PROVIDER=mock

# ---- Provider credentials (all optional; leave blank to disable) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Input limits ----
MAX_AUDIO_DURATION_SECONDS=600
MAX_UPLOAD_BYTES=104857600
DOWNLOAD_TIMEOUT_SECONDS=60

# ---- Rendering (used from Phase 6) ----
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
AUDIO_SAMPLE_RATE=48000
RESOLUTION_16_9=1920x1080
RESOLUTION_9_16=1080x1920
RESOLUTION_1_1=1080x1080
