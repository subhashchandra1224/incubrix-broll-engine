# Normalise text files to LF in the repo and on checkout, so the Docker build
# on Linux is never broken by CRLF line endings.
* text=auto eol=lf

# Binary assets - never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.m4a binary
*.db binary
*.sqlite binary
